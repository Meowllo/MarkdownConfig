{
  "name": "markdownconfig-vscode",
  "displayName": "MarkdownConfig",
  "description": ".mc 文件预览与编辑：config 值蓝色高亮、hover 显示变量名、锚定评论、人工编辑留痕",
  "version": "0.4.0",
  "publisher": "markdownconfig",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/*.mc",
    "onStartupFinished",
    "onLanguage:markdown",
    "onCommand:mc.export",
    "onCommand:mc.addComment",
    "onCommand:mc.editValue",
    "onCommand:mc.resolveComment",
    "onCommand:mc.refreshComments",
    "onCommand:mc.openTarget"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "markdown",
        "aliases": [
          "MarkdownConfig"
        ],
        "extensions": [
          ".mc"
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "markdownconfig",
          "title": "MarkdownConfig",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "markdownconfig": [
        {
          "type": "tree",
          "id": "mcComments",
          "name": "评论（journal）"
        }
      ]
    },
    "commands": [
      {
        "command": "mc.export",
        "title": "MarkdownConfig: 导出配置 JSON",
        "icon": "$(export)"
      },
      {
        "command": "mc.addComment",
        "title": "MarkdownConfig: 添加评论（锚定当前块）",
        "icon": "$(comment-add)"
      },
      {
        "command": "mc.editValue",
        "title": "MarkdownConfig: 编辑当前变量值"
      },
      {
        "command": "mc.resolveComment",
        "title": "MarkdownConfig: 标记评论已解决",
        "icon": "$(check)"
      },
      {
        "command": "mc.refreshComments",
        "title": "MarkdownConfig: 刷新评论",
        "icon": "$(refresh)"
      },
      {
        "command": "mc.openTarget",
        "title": "MarkdownConfig: 打开评论目标"
      },
      {
        "command": "mc.documentMode",
        "title": "MarkdownConfig: 在文档模式中打开（预览编辑）",
        "icon": "$(book)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mc.refreshComments",
          "when": "view == mcComments",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "mc.resolveComment",
          "when": "viewItem == mcComment",
          "group": "inline"
        }
      ],
      "editor/title": [
        {
          "command": "mc.export",
          "when": "resourceExtname == .mc",
          "group": "navigation"
        },
        {
          "command": "mc.documentMode",
          "when": "resourceExtname == .mc",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "mc.addComment",
          "when": "resourceExtname == .mc",
          "group": "markdownconfig"
        },
        {
          "command": "mc.editValue",
          "when": "resourceExtname == .mc",
          "group": "markdownconfig"
        }
      ]
    },
    "configuration": {
      "title": "MarkdownConfig",
      "properties": {
        "markdownconfig.watchHumanEdits": {
          "type": "boolean",
          "default": true,
          "description": "保存 .mc 时自动比对上次状态并留痕：首个保存自动建 journal+快照，之后每次保存把改动路径写入 journal"
        },
        "markdownconfig.highlightConfigValues": {
          "type": "boolean",
          "default": true,
          "description": "把 config 值高亮为蓝色（主题无关）"
        }
      }
    }
  },
  "scripts": {
    "build": "npm --prefix ../core run build && tsc -p ./ && node scripts/bundle.mjs && node scripts/bundle-webview.mjs",
    "test": "npm run build && node --test"
  },
  "dependencies": {
    "@markdownconfig/core": "file:../core",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.0"
  }
}
